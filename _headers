# Supported by Netlify and Cloudflare Pages; vercel.json carries the same rules for Vercel.
# Pages always revalidate. Root scripts are linked with a ?v= content hash, so they never change
# under the same address and can be cached for a year. Media and the other assets keep a week.
# Keep these paths from overlapping: Netlify joins the values of two rules that match one file.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate
/support.js
  Cache-Control: public, max-age=31536000, immutable
/media.js
  Cache-Control: public, max-age=31536000, immutable
/forms.js
  Cache-Control: public, max-age=31536000, immutable
/image-slot.js
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/export-assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/_ds/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
