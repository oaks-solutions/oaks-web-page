{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/home",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/OAKS(%20| )Home.dc.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/OAKS(%20| )Solutions.dc.html",
      "destination": "/solutions",
      "statusCode": 301
    },
    {
      "source": "/OAKS(%20| )About.dc.html",
      "destination": "/about",
      "statusCode": 301
    },
    {
      "source": "/OAKS(%20| )Trust.dc.html",
      "destination": "/trust",
      "statusCode": 301
    },
    {
      "source": "/OAKS(%20| )Contact.dc.html",
      "destination": "/contact",
      "statusCode": 301
    },
    {
      "source": "/OAKS(%20| )Book.dc.html",
      "destination": "/book",
      "statusCode": 301
    },
    {
      "source": "/OAKS(%20| )Partners.dc.html",
      "destination": "/partners",
      "statusCode": 301
    },
    {
      "source": "/OAKS(%20| )Team.dc.html",
      "destination": "/team",
      "statusCode": 301
    },
    {
      "source": "/OAKS(%20| )Case(%20| )Studies.dc.html",
      "destination": "/solutions",
      "statusCode": 301
    },
    {
      "source": "/OAKS(%20| )Technology.dc.html",
      "destination": "/solutions",
      "statusCode": 301
    },
    {
      "source": "/OAKS(%20| )Privacy(%20| )Policy.dc.html",
      "destination": "/privacy",
      "statusCode": 301
    },
    {
      "source": "/OAKS(%20| )Kids(%20| )Privacy(%20| )and(%20| )Safety.dc.html",
      "destination": "/kids-privacy",
      "statusCode": 301
    },
    {
      "source": "/OAKS(%20| )Terms(%20| )and(%20| )Conditions.dc.html",
      "destination": "/terms",
      "statusCode": 301
    },
    {
      "source": "/case-studies",
      "destination": "/solutions",
      "statusCode": 301
    },
    {
      "source": "/technology",
      "destination": "/solutions",
      "statusCode": 301
    },
    {
      "source": "/partner-model",
      "destination": "/partners",
      "statusCode": 301
    },
    {
      "source": "/solutions/ai-assessment",
      "destination": "/solutions#assessments",
      "statusCode": 301
    },
    {
      "source": "/solutions/custom-tech",
      "destination": "/solutions#custom-ai",
      "statusCode": 301
    },
    {
      "source": "/solutions/:path+",
      "destination": "/solutions",
      "statusCode": 301
    },
    {
      "source": "/pricing",
      "destination": "/partners#pricing",
      "statusCode": 301
    },
    {
      "source": "/procurement",
      "destination": "/trust#procurement",
      "statusCode": 301
    },
    {
      "source": "/sub-processors",
      "destination": "/trust#sub-processors",
      "statusCode": 301
    },
    {
      "source": "/subprocessors",
      "destination": "/trust#sub-processors",
      "statusCode": 301
    },
    {
      "source": "/blog",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/blog/:path+",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/ai-builders",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/ai-builders/:path+",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/careers",
      "destination": "/team",
      "statusCode": 301
    },
    {
      "source": "/careers/:path+",
      "destination": "/team",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/solutions",
      "destination": "/OAKS%20Solutions.dc.html"
    },
    {
      "source": "/partners",
      "destination": "/OAKS%20Partners.dc.html"
    },
    {
      "source": "/about",
      "destination": "/OAKS%20About.dc.html"
    },
    {
      "source": "/team",
      "destination": "/OAKS%20Team.dc.html"
    },
    {
      "source": "/trust",
      "destination": "/OAKS%20Trust.dc.html"
    },
    {
      "source": "/contact",
      "destination": "/OAKS%20Contact.dc.html"
    },
    {
      "source": "/book",
      "destination": "/OAKS%20Book.dc.html"
    },
    {
      "source": "/privacy",
      "destination": "/OAKS%20Privacy%20Policy.dc.html"
    },
    {
      "source": "/kids-privacy",
      "destination": "/OAKS%20Kids%20Privacy%20and%20Safety.dc.html"
    },
    {
      "source": "/terms",
      "destination": "/OAKS%20Terms%20and%20Conditions.dc.html"
    }
  ],
  "headers": [
    {
      "source": "/(support|media|forms|image-slot)\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(assets|export-assets|_ds)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    }
  ]
}
